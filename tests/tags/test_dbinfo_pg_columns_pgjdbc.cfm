<cfscript>
suiteBegin("cfdbinfo type=columns: the JDBC column set, and PostgreSQL values as pgjdbc reports them (GH ##514)");

// Lucee passes the JDBC driver's DatabaseMetaData.getColumns through, so on
// PostgreSQL cfdbinfo reports what pgjdbc computes: serial / bigserial /
// smallserial type names, java.sql.Types codes, COLUMN_SIZE and DECIMAL_DIGITS
// from the type's typmod, and SQL NULL where the driver has no value. Every
// expected value below was produced by Lucee 7.1.2.191 against PostgreSQL 18
// (2026-11-15). The PostgreSQL part needs RUSTCFML_TEST_PG_URL; the column set
// is checked on SQLite every run.

jdbcColumns = "TABLE_CAT,TABLE_SCHEM,TABLE_NAME,COLUMN_NAME,DATA_TYPE,TYPE_NAME,COLUMN_SIZE,BUFFER_LENGTH,DECIMAL_DIGITS,NUM_PREC_RADIX,NULLABLE,REMARKS,COLUMN_DEFAULT_VALUE,SQL_DATA_TYPE,SQL_DATETIME_SUB,CHAR_OCTET_LENGTH,ORDINAL_POSITION,IS_NULLABLE,SCOPE_CATALOG,SCOPE_SCHEMA,SCOPE_TABLE,SOURCE_DATA_TYPE,IS_AUTOINCREMENT,IS_GENERATEDCOLUMN";

// ---- the column set, on every driver (checked on SQLite) ----
liteDs = { class: "org.sqlite.JDBC", connectionString: "jdbc:sqlite:" & getTempDirectory() & "rcfml_dbinfo_cols_" & getTickCount() & ".db" };
queryExecute( "create table t ( id integer primary key, s varchar(10) )", [], { datasource: liteDs } );
cfdbinfo( type = "columns", table = "t", datasource = liteDs, name = "liteCols" );
assert( "columns: the JDBC set, then Lucee's key columns", liteCols.columnList,
	jdbcColumns & ",IS_PRIMARYKEY,IS_FOREIGNKEY,REFERENCED_PRIMARYKEY,REFERENCED_PRIMARYKEY_TABLE" );
cfdbinfo( type = "columns_minimal", table = "t", datasource = liteDs, name = "liteMin" );
assert( "columns_minimal: exactly the JDBC set", liteMin.columnList, jdbcColumns );

// ---- PostgreSQL values ----
pgDs = "";
try {
	pgDs = server.system.environment.RUSTCFML_TEST_PG_URL ?: "";
} catch ( any e ) {
	pgDs = "";
}
if ( !len( pgDs ) ) {
	writeOutput( "  (PostgreSQL part skipped - set RUSTCFML_TEST_PG_URL to enable)" & chr( 10 ) );
} else {
	sfx = lCase( left( replace( createUUID(), "-", "", "all" ), 8 ) );
	tbl = "zz_rcfml_dbinfo_" & sfx;
	dom = "zz_rcfml_dom_" & sfx;
	enm = "zz_rcfml_enum_" & sfx;
	try {
		queryExecute( "create domain #dom# as varchar(7) not null", [], { datasource: pgDs } );
		queryExecute( "create type #enm# as enum ('a', 'b')", [], { datasource: pgDs } );
		queryExecute( "create table #tbl# ( id serial primary key, n int not null default 5, b boolean, s varchar(20), t text,
			ts timestamp, tstz timestamptz(3), d numeric(10,2), bi bigint, si smallint, ss smallserial, bs bigserial,
			dt date, tm time, f4 real, f8 double precision, ch char(3), by bytea, u uuid, j jsonb, ar int[],
			g int generated always as (n * 2) stored, ident int generated by default as identity,
			dm #dom#, en #enm#, nu numeric, va varchar(5)[], iv interval, ttz timetz(2), bt bit(3), t0 timestamp(0) )",
			[], { datasource: pgDs } );
		queryExecute( "comment on column #tbl#.n is 'the n'", [], { datasource: pgDs } );
		cfdbinfo( type = "columns", table = tbl, datasource = pgDs, name = "cols" );
		assert( "pg: the column set", cols.columnList,
			jdbcColumns & ",IS_PRIMARYKEY,IS_FOREIGNKEY,REFERENCED_PRIMARYKEY,REFERENCED_PRIMARYKEY_TABLE" );

		// column -> "TYPE_NAME DATA_TYPE COLUMN_SIZE DECIMAL_DIGITS CHAR_OCTET_LENGTH"
		expected = {
			id: "serial 4 10 0 ", n: "int4 4 10 0 ", b: "bool -7 1 0 ", s: "varchar 12 20 0 20",
			t: "text 12 2147483647 0 2147483647", ts: "timestamp 93 29 6 ", tstz: "timestamptz 93 32 3 ",
			d: "numeric 2 10 2 ", bi: "int8 -5 19 0 ", si: "int2 5 5 0 ", ss: "smallserial 5 5 0 ",
			bs: "bigserial -5 19 0 ", dt: "date 91 13 0 ", tm: "time 92 15 6 ", f4: "float4 7 8 8 ",
			f8: "float8 8 17 17 ", ch: "bpchar 1 3 0 3", by: "bytea -2 2147483647 0 2147483647",
			u: "uuid 1111 2147483647 0 ", j: "jsonb 1111 2147483647 0 ", ar: "_int4 2003 10 0 ",
			g: "int4 4 10 0 ", ident: "int4 4 10 0 ", dm: "#dom# 2001 11 0 ", en: "#enm# 12 2147483647 0 2147483647",
			nu: "numeric 2 0  ", va: "_varchar 2003 5 0 ", iv: "interval 1111 49 6 ", ttz: "timetz 92 17 2 ",
			bt: "bit -7 3 0 ", t0: "timestamp 93 22 0 "
		};
		for ( r in cols ) {
			assert( "pg: #r.column_name# type, code, size, digits, octets",
				r.type_name & " " & r.data_type & " " & r.column_size & " " & r.decimal_digits & " " & r.char_octet_length,
				expected[ r.column_name ] ?: "(unexpected column)" );
		}
		byName = {};
		for ( r in cols ) byName[ r.column_name ] = r;
		assert( "pg: serial is auto-increment", byName.id.is_autoincrement, "YES" );
		assert( "pg: an identity column is auto-increment", byName.ident.is_autoincrement, "YES" );
		assert( "pg: a plain column is not", byName.n.is_autoincrement, "NO" );
		assert( "pg: a generated column", byName.g.is_generatedcolumn, "YES" );
		assert( "pg: a generated column's default is its expression", byName.g.column_default_value, "(n * 2)" );
		assert( "pg: REMARKS is the column comment", byName.n.remarks, "the n" );
		assert( "pg: a domain's SOURCE_DATA_TYPE is its base type", byName.dm.source_data_type, 12 );
		assert( "pg: a NOT NULL domain is not nullable", byName.dm.is_nullable, "NO" );
		assert( "pg: BUFFER_LENGTH is NULL", byName.n.buffer_length, "" );
		assert( "pg: SQL_DATA_TYPE is NULL", byName.n.sql_data_type, "" );
		assert( "pg: ORDINAL_POSITION counts columns", byName.t0.ordinal_position, 31 );
		assert( "pg: TABLE_CAT is the database", byName.id.table_cat, queryExecute( "select current_database() as d", [], { datasource: pgDs } ).d );
	} finally {
		try { queryExecute( "drop table if exists #tbl#", [], { datasource: pgDs } ); } catch ( any e ) {}
		try { queryExecute( "drop domain if exists #dom#", [], { datasource: pgDs } ); } catch ( any e ) {}
		try { queryExecute( "drop type if exists #enm#", [], { datasource: pgDs } ); } catch ( any e ) {}
	}
}

suiteEnd();
</cfscript>
