# Build artifacts
/target/
**/*.rs.bk

# `rustcfml --build` cocktail build dirs (auto-generated per app)
**/.rustcfml-cocktail/

# WASM build output (rebuilt by CI)
crates/wasm/pkg/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Playwright MCP scratch output
/.playwright-mcp/

# Environment
.env
.env.*

# Temporary test files
whitebackground.png

# Profiling output (`--features obs-pprof`) — raw pprof + flamegraph renders.
# These reached ~145MB of stale baselines in the repo root; always re-profile fresh.
/rustcfml-profile*.pb
/rustcfml-profile*.svg

# Screen grabs / accessibility snapshots from browser-driven debugging sessions
/*.png
/snap*.md

# Python bytecode cache (from the pprof_*.py parsers in the repo root)
__pycache__/
*.pyc

# CommandBox per-experiment server definitions (server.json + the tracked
# server-rcfml-lucee.json are the real ones; the rest are throwaway)
/server-*.json
!/server-rcfml-lucee.json

# Node tooling (Claude Code CLI install, not project deps)
/node_modules/
/package.json
/package-lock.json

# Local working / planning notes (not part of the repo)
/Compatibility.md
/NEXT_SESSION.md
/PERFORMANCE_TUNING.md
/REFERENCE_SEMANTICS_PLAN.md
/moopareview.md
# Preside working/handoff notes — keep untracked (kept re-appearing in the repo)
/PRESIDE_BOOT_NEXT_STEPS.md
/PresideTestCompatibility.md
/PRESIDE_BOOT_JAVA_NOOPS.md
/PRESIDE_CFCONCURRENT_PLAN.md
# WebSocket plan/design are working docs (user-facing docs/websockets.md IS tracked)
/docs/websocket-design.md
/docs/websocket-implementation-plan.md
# Observability plan/design are working docs (never meant to be committed)
/docs/observability-design.md
/docs/observability-implementation-plan.md

# Sibling standalone worker repo — accidentally committed here in the past,
# now lives at github.com/RustCFML/Rust-CFML-Cloudflare-worker
/RustCFMLWorker/

# Generated sqlite test datasource artifact (served-mode cfconfig tests)
testds
# Stray SQLite DB materialised from a "sqlite::memory:" DSN used as a path.
# The ':' is illegal on Windows and breaks `git checkout` in CI — never track it.
sqlite::memory:

# CFML log files written by <cflog>/writeLog() — the CLI's default log
# directory is ./logs, so a test-suite run lands them here.
/logs/

# PGO training artifacts kept for provenance, NOT for the build.
# The profile the build actually uses is pgo/rustcfml.profdata (tracked).
# Everything under pgo/archive/ is historical evidence — tens of MB of
# .profdata that must never enter git history. See pgo/archive/README.md.
/pgo/archive/
